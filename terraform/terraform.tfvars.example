# Example Terraform Variable Configuration for CloudPulse
# Copy this file to terraform.tfvars and customize for your environment:
#   cp terraform.tfvars.example terraform.tfvars
# WARNING: Do NOT commit terraform.tfvars containing personal values to git!

aws_region          = "ap-south-1"
project_name        = "cloudpulse"
environment         = "dev"

# Networking Configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones  = ["ap-south-1a", "ap-south-1b"]

# Amazon EKS Cluster Configuration (using 1.36 for optimal standard-support window)
cluster_name        = "cloudpulse-eks"
kubernetes_version  = "1.36"

# EKS Worker Node Group Scaling & Instance Type
# Conservative sizing to minimize AWS charges:
node_instance_types = ["t3.small"]
node_desired_size   = 1
node_min_size       = 1
node_max_size       = 2
